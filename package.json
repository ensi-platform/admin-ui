{
    "name": "@ensi-platform/admin-ui-base",
    "version": "0.0.0",
    "description": "Admin UI primitives for Ensi admin panel",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./badge": {
            "types": "./dist/badge/index.d.ts",
            "import": "./dist/badge/index.js"
        },
        "./button": {
            "types": "./dist/button/index.d.ts",
            "import": "./dist/button/index.js"
        },
        "./checkbox": {
            "types": "./dist/checkbox/index.d.ts",
            "import": "./dist/checkbox/index.js"
        },
        "./checkbox-group": {
            "types": "./dist/checkbox-group/index.d.ts",
            "import": "./dist/checkbox-group/index.js"
        },
        "./field": {
            "types": "./dist/field/index.d.ts",
            "import": "./dist/field/index.js"
        },
        "./form": {
            "types": "./dist/form/index.d.ts",
            "import": "./dist/form/index.js"
        },
        "./hooks": {
            "types": "./dist/hooks/index.d.ts",
            "import": "./dist/hooks/index.js"
        },
        "./icon": {
            "types": "./dist/icon/index.d.ts",
            "import": "./dist/icon/index.js"
        },
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons/index.js"
        },
        "./input": {
            "types": "./dist/input/index.d.ts",
            "import": "./dist/input/index.js"
        },
        "./multi-select": {
            "types": "./dist/multi-select/index.d.ts",
            "import": "./dist/multi-select/index.js"
        },
        "./number-input": {
            "types": "./dist/number-input/index.d.ts",
            "import": "./dist/number-input/index.js"
        },
        "./provider": {
            "types": "./dist/provider/index.d.ts",
            "import": "./dist/provider/index.js"
        },
        "./select": {
            "types": "./dist/select/index.d.ts",
            "import": "./dist/select/index.js"
        },
        "./switch": {
            "types": "./dist/switch/index.d.ts",
            "import": "./dist/switch/index.js"
        },
        "./tag": {
            "types": "./dist/tag/index.d.ts",
            "import": "./dist/tag/index.js"
        },
        "./textarea": {
            "types": "./dist/textarea/index.d.ts",
            "import": "./dist/textarea/index.js"
        },
        "./typography": {
            "types": "./dist/typography/index.d.ts",
            "import": "./dist/typography/index.js"
        },
        "./tokens": "./dist/tokens/index.css"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "sync-package": "node --experimental-strip-types scripts/sync-package.ts",
        "build": "pnpm sync-package && vite build && mkdir -p dist/tokens && cp src/ds/tokens/*.css dist/tokens/",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint ./src ./.storybook ./scripts --fix",
        "format": "prettier ./src --write --ignore-unknown --ignore-path .prettierignore",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "hooks:setup": "chmod +x .githooks/pre-commit && git config core.hooksPath .githooks"
    },
    "keywords": [
        "ensi",
        "admin",
        "ui",
        "primitives",
        "react"
    ],
    "license": "SEE LICENSE IN LICENSE",
    "packageManager": "pnpm@10.14.0",
    "peerDependencies": {
        "@hookform/resolvers": "^5",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19",
        "react-hook-form": "^7",
        "zod": "^4"
    },
    "devDependencies": {
        "@ensi-platform/eslint-config-a11y": "^0.1.1",
        "@ensi-platform/eslint-config-base": "^0.2.1",
        "@ensi-platform/eslint-config-react": "^0.1.2",
        "@ensi-platform/eslint-config-typescript": "^0.1.1",
        "@ensi-platform/prettier-config": "^0.2.0",
        "@hookform/resolvers": "^5.4.0",
        "@storybook/addon-docs": "10.5.3",
        "@storybook/addon-themes": "10.5.3",
        "@storybook/react": "10.5.3",
        "@storybook/react-vite": "10.5.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.39.5",
        "glob": "^11.0.3",
        "jsdom": "^29.1.1",
        "prettier": "3.9.5",
        "react": "^19",
        "react-dom": "^19",
        "react-hook-form": "^7.82.0",
        "storybook": "10.5.3",
        "typescript": "^6.0.3",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-lib-inject-css": "^2.2.2",
        "vitest": "^4.1.10",
        "zod": "^4.4.3"
    },
    "homepage": "https://ensi.tech",
    "repository": {
        "type": "git",
        "url": "git@git.greensight.ru:ensi/opensource/packages/admin-ui/admin-ui-base.git"
    },
    "dependencies": {
        "class-variance-authority": "0.7.1",
        "classnames": "2.5.1",
        "react-aria-components": "^1.19.0",
        "react-fast-compare": "^3.2.2"
    }
}
