{
    "name": "@ensi-platform/admin-ui-base",
    "version": "0.0.0",
    "description": "Admin UI primitives for Ensi admin panel",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./button": {
            "types": "./dist/button/index.d.ts",
            "import": "./dist/button/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint ./src ./.storybook --fix",
        "format": "prettier ./src --write --ignore-unknown --ignore-path .prettierignore",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "ensi",
        "admin",
        "ui",
        "primitives",
        "react"
    ],
    "license": "SEE LICENSE IN LICENSE",
    "packageManager": "pnpm@10.14.0",
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "devDependencies": {
        "@ensi-platform/eslint-config-a11y": "^0.1.1",
        "@ensi-platform/eslint-config-base": "^0.2.1",
        "@ensi-platform/eslint-config-react": "^0.1.2",
        "@ensi-platform/eslint-config-typescript": "^0.1.1",
        "@ensi-platform/prettier-config": "^0.2.0",
        "@storybook/react": "10.5.3",
        "@storybook/react-vite": "10.5.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.39.5",
        "glob": "^11.0.3",
        "jsdom": "^29.1.1",
        "prettier": "3.9.5",
        "react": "^19",
        "react-dom": "^19",
        "storybook": "10.5.3",
        "typescript": "^6.0.3",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-lib-inject-css": "^2.2.2",
        "vitest": "^4.1.10"
    },
    "homepage": "https://ensi.tech",
    "repository": {
        "type": "git",
        "url": "git@git.greensight.ru:ensi/opensource/packages/admin-ui/admin-ui-base.git"
    },
    "dependencies": {
        "class-variance-authority": "0.7.1",
        "classnames": "2.5.1"
    }
}
