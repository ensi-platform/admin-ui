{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@/*": ["./src/*"],
            "@ds/*": ["./src/ds/*"]
        },
        "types": ["vite/client"]
    },
    "include": ["src/**/*", ".storybook/**/*", "scripts/**/*", "vite.config.ts", "vitest.setup.ts"]
}
